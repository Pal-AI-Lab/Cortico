{
  "name": "cortico-bot-example",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico bot template: one Persona, one session, console only, a MEMORY.md as Memory",
  "license": "MIT",
  "keywords": [
    "cortico-bot",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./index.ts",
  "cortico": {
    "kind": "bot",
    "api": 7,
    "tags": []
  },
  "files": [
    "index.ts",
    "persona",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.1.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
