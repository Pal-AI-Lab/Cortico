{
  "name": "cortico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A TypeScript framework for event-driven, long-running persona bots",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pal-AI-Lab/Cortico.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "start": "node bin/cortico.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "build:web": "tsx scripts/build-web.ts && tailwindcss -i src/web/public/styles.css -o dist/web/styles.css --minify",
    "audit:release": "tsx scripts/release-audit.ts",
    "publish:package": "tsx scripts/publish-package.ts",
    "check:extension": "tsx scripts/extension-check.ts",
    "logq": "tsx scripts/logq.ts",
    "dev:console": "tsx scripts/dev-console.ts",
    "bots": "tsx src/launcher.ts --list"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "express": "^4.21.2",
    "fflate": "0.8.3",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-textarea-autosize": "^8.5.9",
    "tar-stream": "3.2.1",
    "vec3": "^0.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/tar-stream": "3.1.4",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
