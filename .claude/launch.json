        "scripts/dev-webui.ts"
      ],
      "port": 8848,
      "autoPort": true
    },
    {
      "name": "dev-webui-en",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=scratch/lang-en.env",
        "node_modules/tsx/dist/cli.mjs",
        "scripts/dev-webui.ts"
      ],
      "port": 8848,
      "autoPort": true
    },
    {
      "name": "canvas-game-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/tsx/dist/cli.mjs",
        "scratch/canvas-game-preview.ts"
      ],
