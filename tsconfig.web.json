{
  // 浏览器类型库配置,不加载 @types/node。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "noEmit": true
  },
  // 显式 files 会关闭 include 无匹配文件时的 TS18003 检查。
  "files": [],
  // 清空继承的 exclude,使浏览器文件进入初始文件表。
  "exclude": [],
  // 覆盖根配置排除的浏览器文件;未列入的文件仅在被导入时参与检查。
  "include": [
    "src/web/client/**/*.ts",
    "src/providers/*/console/client.ts",
    "src/providers/*/console/*-panel.ts",
    "src/web/client/**/*.tsx",
    "src/web/shared/**/*.ts",
    "src/worlds/*/console/**/*.ts",
    "bots/*/console/**/*.ts",
    // jsdom 测试使用 DOM 类型。
    "tests/web/feature-prompts.test.ts",
    "tests/web/client-main.test.ts",
    "tests/web/client-language.test.ts",
    "tests/web/settings-general.test.ts",
    "tests/web/feature-providers.test.ts",
    "tests/web/feature-extensions.test.ts"
  ]
}
